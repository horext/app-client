{
  "name": "horext-ssr-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check --ignore-path .gitignore \"**/*.{js,ts,vue}\"",
    "lint": "yarn lint:js && yarn lint:prettier",
    "lint:fix": "prettier --write --ignore-path .gitignore \"**/*.{js,ts,vue}\" && pnpm lint:js --fix",
    "test:unit": "vitest",
    "test:unit:cov": "vitest --coverage",
    "test:unit:ci": "vitest run --coverage && pnpm test:sync:cov",
    "test:sync:cov": "vitest run modules/synchronization app/composables/__tests__/cloud-sync.spec.ts --project unit --project nuxt --coverage --coverage.include='modules/synchronization/index.ts' --coverage.include='modules/synchronization/runtime/**/*.ts' --coverage.exclude='modules/synchronization/**/__tests__/**' --coverage.thresholds.lines=70 --coverage.thresholds.functions=70 --coverage.thresholds.branches=70 --coverage.thresholds.statements=70 --coverage.reporter=text-summary --reporter=dot",
    "test:types": "nuxi prepare && vue-tsc --noEmit",
    "bench": "vitest bench --run --project=bench --outputJson=.bench/results-baseline.json",
    "bench-compare": "vitest bench --run --project=bench --compare=.bench/results-baseline.json",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxt/image": "^2.1.0",
    "@nuxt/nitro-server": "4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@pinia/nuxt": "^1.0.2",
    "@unhead/vue": "^3.3.2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "^11.0.2",
    "html2canvas-pro": "^2.3.9",
    "h3": "1.15.11",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lottie-web": "^5.13.0",
    "luxon": "^3.7.2",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "ufo": "^1.6.4",
    "unhead": "^3.3.2",
    "unstorage": "^1.17.5",
    "uuid": "^14.0.2",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@mdi/js": "^7.4.47",
    "@nuxt/devtools": "4.0.0-alpha.9",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/scripts": "^1.3.6",
    "@nuxt/test-utils": "^4.1.0",
    "@types/google.accounts": "^0.0.18",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/uuid": "^11.0.0",
    "@unhead/schema": "^3.3.2",
    "@unocss/nuxt": "^66.7.5",
    "@unocss/preset-wind4": "^66.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.6",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "nitropack": "^2.13.4",
    "nuxt": "^4.5.2",
    "nuxt-gtag": "^5.0.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "unocss": "^66.7.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
